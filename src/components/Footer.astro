---
import { site } from '../data/site';

const reversedEmail = site.email.split('').reverse().join('');
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<img class="site-footer__banner" src={site.kidsBanner} alt="" width="400" loading="lazy" />

		<p class="site-footer__email">
			✉️ <strong>
				<a
					href="#"
					data-email={reversedEmail}
					onclick="this.href='mailto:'+this.dataset.email.split('').reverse().join('')"
					style="unicode-bidi:bidi-override;direction:rtl"
				>
					{reversedEmail}
				</a>
			</strong>
		</p>

		<address>
			<strong>{site.legalName}</strong><br />
			{site.address[0]}<br />
			{site.address[1]}
		</address>

		<p class="site-footer__support">
			<img class="site-footer__city-logo" src={site.cityLogo} alt="Město Čelákovice" width="50" height="55" />
			Činnost spolku je finančně podporována městem Čelákovice.
		</p>
	</div>
</footer>
