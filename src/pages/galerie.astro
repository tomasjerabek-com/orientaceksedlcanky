---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { gallerySections } from '../data/gallery';
---

<BaseLayout
	title="Galerie"
	description="Fotografie z tréninků, závodů a zakončení sezony Orienťáčku Sedlčánky."
	image="/media/posts/2/gallery/zakonceni20242.jpeg"
	canonical="/galerie/"
>
	<div class="page-shell">
		<div class="container">
			<header class="page-hero page-hero--card">
				<span class="section__eyebrow">Vzpomínky z terénu</span>
				<h1>Galerie</h1>
				<p>Okamžiky z našich závodů, tréninků a společných akcí.</p>
			</header>

			{
				gallerySections.map((section) => (
					<section class="gallery-section">
						<h2>{section.title}</h2>
						<GalleryGrid images={section.images} altPrefix={section.title} />
					</section>
				))
			}
		</div>
	</div>
</BaseLayout>
