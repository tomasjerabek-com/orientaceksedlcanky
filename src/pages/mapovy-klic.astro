---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Mapový klíč"
	description="Mapový klíč pro orientační běh – vysvětlení značek na mapách Orienťáčku."
	image="/media/posts/4/mapovy-klic-2.png"
	canonical="/mapovy-klic/"
>
	<div class="page-shell">
		<div class="container">
			<header class="page-hero page-hero--card">
				<span class="section__eyebrow">Orientace</span>
				<h1>Mapový klíč</h1>
				<p>Přehled mapových značek, které potkáte při orientačním běhu.</p>
			</header>

			<figure class="featured-image">
				<img
					src="/media/posts/4/mapovy-klic-2.png"
					alt="Mapový klíč orientačního běhu"
					width="1200"
					height="1600"
				/>
			</figure>
		</div>
	</div>
</BaseLayout>
