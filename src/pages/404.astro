	<div class="page-shell">
		<div class="container">
			<header class="page-hero page-hero--card" style="text-align: center;">
				<span class="section__eyebrow">404</span>
				<h1>Tudy cesta nevede</h1>
				<p>Tahle kontrola na mapě není. Zkuste se vrátit na start.</p>
				<p style="margin-top: 1.5rem;">
					<a class="button button--primary" href="/">Zpět na úvod</a>
				</p>
			</header>
		</div>
	</div>
</BaseLayout>
